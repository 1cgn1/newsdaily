[Unit]
Description=Check newsdaily credentials without printing values

[Service]
Type=oneshot
TimeoutStartSec=2min
User=newsdaily
Group=newsdaily
WorkingDirectory=/opt/newsdaily
EnvironmentFile=/etc/newsdaily/config
SetCredential=deepseek_api_key:__NEWSDaily_UNCONFIGURED_MODEL_CREDENTIAL__
SetCredential=openai_api_key:__NEWSDaily_UNCONFIGURED_MODEL_CREDENTIAL__
SetCredential=dashscope_api_key:__NEWSDaily_UNCONFIGURED_MODEL_CREDENTIAL__
LoadCredential=deepseek_api_key:/etc/newsdaily/credentials/deepseek_api_key
LoadCredential=openai_api_key:/etc/newsdaily/credentials/openai_api_key
LoadCredential=dashscope_api_key:/etc/newsdaily/credentials/dashscope_api_key
LoadCredential=smtp_auth_code:/etc/newsdaily/credentials/smtp_auth_code
LoadCredential=sender_email:/etc/newsdaily/credentials/sender_email
LoadCredential=recipient_email:/etc/newsdaily/credentials/recipient_email
ExecStart=/opt/newsdaily/.venv/bin/python -B -c "import json; from app.credentials import CredentialProvider; s=json.load(open('config/settings.json', encoding='utf-8')); n={'deepseek':'DEEPSEEK_API_KEY','openai':'OPENAI_API_KEY','qwen':'DASHSCOPE_API_KEY'}[s['model_provider']]; c=CredentialProvider(); [c.get(k) for k in (n,'SMTP_AUTH_CODE','MAIL_FROM','MAIL_TO')]; print('Required credentials are available')"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
